# ==================================================
# QuantSpeed Backend Configuration (.env.example)
# ==================================================

# Server Configuration
PORT=3000
# Set to 'production' for live deployments (disables dev mock auth)
NODE_ENV=production
# Set to 'false' in production; 'true' only for local mock debugging
ALLOW_DEV_AUTH=false
CORS_ORIGIN=*

# Admin API Key for Internal Scheduled Jobs
ADMIN_API_KEY=your_admin_api_key_here

# Firebase Configuration
FIREBASE_PROJECT_ID=quantspeed-math
FIREBASE_DATABASE_URL=https://quantspeed-math-default-rtdb.firebaseio.com
# Path to service account json or raw json string (Render Secret Files: /etc/secrets/serviceAccountKey.json)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Razorpay Credentials (Use rzp_live_... for production, rzp_test_... for sandbox)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Razorpay Plan IDs
RAZORPAY_PLAN_1_MONTH=plan_your_1_month_id
RAZORPAY_PLAN_3_MONTHS=plan_your_3_months_id
RAZORPAY_PLAN_6_MONTHS=plan_your_6_months_id
RAZORPAY_PLAN_1_YEAR=plan_your_1_year_id

# Notification Throttling
BATTLE_NOTIFICATION_COOLDOWN_SECONDS=300
