# ==================================================
# QuantSpeed Backend Configuration (.env.example)
# ==================================================

# Server Configuration
PORT=3000
NODE_ENV=development
ALLOW_DEV_AUTH=true
CORS_ORIGIN=*

# Admin API Key for Internal Scheduled Jobs
ADMIN_API_KEY=your_admin_api_key_here

# Firebase Configuration
FIREBASE_PROJECT_ID=quantspeed-math
FIREBASE_DATABASE_URL=https://quantspeed-math-default-rtdb.firebaseio.com
# Path to service account json or raw json string (never commit private keys)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Razorpay Test Mode Credentials (Get from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Razorpay Plan IDs (Created via scripts/setup_razorpay_plans.js or Razorpay Dashboard)
RAZORPAY_PLAN_1_MONTH=plan_test_plan_1_month
RAZORPAY_PLAN_3_MONTHS=plan_test_plan_3_months
RAZORPAY_PLAN_6_MONTHS=plan_test_plan_6_months
RAZORPAY_PLAN_1_YEAR=plan_test_plan_1_year

# Notification Throttling
BATTLE_NOTIFICATION_COOLDOWN_SECONDS=300
